{
    "name": "maqiis/document-builder",
    "description": "Pembangun dokumen surat berbasis blok dengan keluaran HTML, cetak, dan PDF",
    "type": "library",
    "license": "proprietary",
    "bin": [
        "bin/document-builder-verify-print"
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "ext-gd": "*",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0",
        "livewire/livewire": "^2.12|^3.0",
        "mpdf/mpdf": "^8.3",
        "phpunit/phpunit": "^10.0"
    },
    "suggest": {
        "mpdf/mpdf": "Diperlukan oleh MpdfEngine untuk menghasilkan PDF",
        "livewire/livewire": "Diperlukan oleh komponen penyusun Blade (document-builder::template-builder)"
    },
    "autoload": {
        "psr-4": {
            "Maqiis\\DocumentBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maqiis\\DocumentBuilder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Maqiis\\DocumentBuilder\\Laravel\\DocumentBuilderServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "stable"
}
